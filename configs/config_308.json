{
    "expname": "exp308",
    "machine": "falco",
    "seed": 21,
    "device": "gpu",

    "data": {
        "tags_loadname": "exp004_seed88",

        "training_years": [2015, 2019],
        "training_region": [-60, 60, -180, 180],

        "inference_years": [2020],
        "inference_region": {"tilelats": [[40], [30], [50], [0], [10], [-30]],
                             "tilelons": [[-100], [110], [0], [-80], [0], [140]]
                            },

        "channels": [1, 3, 6],
        "scene_width": 11

    },

    "architecture": {
        "type": "resnet",
        "resnet_pretrained": true,
        "resnet_trainable": true,
        "resnet_drop_layer": -4,

        "input_noise": 5,

        "dense_in": [49288],
        "dense_units": [128],
        "dense_activations": ["ReLU"],

        "dropout": 0.0,

        "final_in": 128,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 0,
        "pin_memory": false,

        "batch_size": 32,
        "n_repeat_tile": 2,
        "max_batches": 100000,
        "max_epochs": 100000,

        "val_batch_size": 32,
        "val_n_repeat_tile": 1,
        "val_max_batches": 1000000,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": 5,
                "zero_threshold": 3,
                "one_weighting": 5,
                "one_threshold": 0.9,
                "kluge_value_for_zero": 0.25
            }
        },

        "early_stopping":{
            "args":{
                "patience": 5,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "lr_scheduler": {
        "type": "ReduceLROnPlateau",
        "args": {
            "mode": "min",
            "factor": 0.5,
            "patience": 3,
            "threshold": 0.01,
            "threshold_mode": "rel",
            "cooldown": 0,
            "min_lr": 1e-07,
            "eps": 1e-08
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

{
    "expname": "exp002",
    "machine": "falco",
    "seed": 22,
    "mode": null,
    "device": "gpu",

    "data": {
        "training_years": [2015, 2020],
        "inference_years": [2020],
        "training_region": [0, 20, 0, 20],
        "inference_region": [0, 20, 0, 20],

        "channels": [1, 2, 3, 4, 5, 6],
        "scene_width": 11,

        "percentage_sampling": 0.05,
        "val_frac": 0.05,

        "kluge_value_for_zero": -0.2
    },

    "architecture": {
        "input_noise": 5,

        "filters": [128, 128, 128, 128, 128],
        "cnn_activation": ["ReLU","ReLU","ReLU","ReLU","ReLU"],
        "kernel_size": [3, 3, 3, 3, 3],

        "dense_in": [14148],
        "dense_units": [64],
        "dense_activations": ["ReLU"],

        "dropout": 0.10,

        "final_in": 64,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 1,
        "pin_memory": false,
        "batch_size": 4096
    },

    "trainer": {
        "resume_training": false,
        "batch_size": 32,
        "batches_per_epoch": 500,
        "max_epochs": 10000,

        "loss":{
            "type": "SMSELoss",
            "args": {
                "zero_weighting": null
            }
        },

        "early_stopping":{
            "args":{
                "patience": 5,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.00005,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

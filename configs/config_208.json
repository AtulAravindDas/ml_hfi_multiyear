{
    "expname": "exp208",
    "machine": "blackforest",
    "seed": 21,
    "device": "gpu",

    "data": {
        "tags_loadname": "exp001_seed55",

        "training_years": [2015, 2019],
        "training_region": [0, 20, 0, 20],

        "inference_years": [2020],
        "inference_region": {"tilelats": [[40], [30], [50], [0], [10], [-30]],
                             "tilelons": [[-100], [110], [0], [-80], [0], [140]]
                            },

        "channels": [2, 4, 6],
        "scene_width": 11

    },

    "architecture": {
        "type": "cnn",
        "input_noise": 0,

        "filters": [64, 64, 64, 64, 64],
        "cnn_activation": ["ReLU","ReLU","ReLU","ReLU","ReLU"],
        "kernel_size": [3, 3, 3, 3, 3],

        "skip_channels": [1, -1],

        "dense_in": [25224],
        "dense_units": [64],
        "dense_activations": ["ReLU"],

        "dropout": 0.0,

        "final_in": 64,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5
    },

    "trainer": {

        "resume_training": false,
        "num_workers": 2,
        "pin_memory": true,

        "batch_size": 32,
        "n_repeat_tile": 100,
        "max_batches": 100000,
        "max_epochs": 1000,

        "val_batch_size": 32,
        "val_n_repeat_tile": 10,
        "val_max_batches": 100000,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": null,
                "zero_threshold": null,
                "one_weighting": null,
                "one_threshold": null,
                "kluge_value_for_zero": 0.2
            }
        },

        "early_stopping":{
            "args":{
                "patience": 5,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.000001,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "lr_scheduler": {
        "type": "MultiStepLR",
        "args": {
            "milestones": [4000],
            "gamma": 0.1,
            "last_epoch": -1
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

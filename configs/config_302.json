{
    "expname": "exp302",
    "machine": "falco",
    "seed": 33,
    "mode": null,
    "device": "gpu",

    "data": {
        "globaltags_loadname": "exp011_seed22",

        "training_years": [2015, 2019],
        "inference_years": [2020],
        "training_region": [0, 20, 0, 20],
        "inference_region": [5, 6, 7, 9],

        "channels": [1, 2, 3, 4, 5, 6],
        "scene_width": 11,

        "percentage_sampling": 0.05,
        "val_frac": 0.05,

        "oversample_rare_bins": true,
        "oversample_rate": 10.0,
        "kluge_value_for_zero": null
    },

    "architecture": {
        "type": "vit",

        "channels": 6,
        "patch_size": 11,
        "dim": 256,
        "depth": 6,
        "heads": 8,
        "mlp_dim": 512,

        "input_noise": 5
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 2,
        "pin_memory": true,

        "batch_size": 128,
        "batches_per_epoch": 100,
        "max_epochs": 30,
        "max_val_batches": 25,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": 10.0,
                "one_weighting": null,
                "one_threshold": null
            }
        },

        "early_stopping":{
            "args":{
                "patience": 100,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.00001,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

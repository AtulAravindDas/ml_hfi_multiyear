{
    "expname": "exp211",
    "machine": "blackforest",
    "task": "prognostic",
    "seed": 21,
    "device": "gpu",

    "data": {
        "tags_loadname": null,

        "training_years": [2015],
        "training_region": [-10, 0, 10, 40],

        "inference_years": [2015],
        "inference_region": [-10, 0, 10, 40],

        "channels": [2, 4, 6],
        "scene_width": 11,

        "prognostic_leadtime": 5,

        "percentage_sampling": 0.05,
        "val_frac": 0.05,
        "min_binfrac_for_tile": 0.0,
        "min_samples_in_tile": 0,
        "oversample_rare_bins": true,
        "oversample_rate": 10.0

    },

    "architecture": {
        "type": "resnet",
        "resnet_pretrained": true,
        "resnet_trainable": true,
        "resnet_drop_layer": -3,

        "skip_channels": [1, -1],

        "dense_in": [12544, 128],
        "dense_units": [128, 128],
        "dense_activations": ["ReLU","ReLU"],

        "dropout": 0.00,

        "final_in": 128,
        "final_activation": "Tanh",

        "input_noise": 0
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 2,
        "pin_memory": true,

        "batch_size": 32,
        "n_repeat_tile": 2000,
        "max_batches": 100000,
        "max_epochs": 1000,

        "val_batch_size": 32,
        "val_n_repeat_tile": 250,
        "val_max_batches": 100000,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": null,
                "zero_threshold": null,
                "one_weighting": null,
                "one_threshold": null,
                "kluge_value_for_zero": null
            }
        },

        "early_stopping":{
            "args":{
                "patience": 5,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "SGD",
        "args":{
            "lr": 0.0001,
            "momentum": 0.9
        }
    },

    "lr_scheduler": {
        "type": "MultiStepLR",
        "args": {
            "milestones": [5, 200],
            "gamma": 0.1,
            "last_epoch": -1
        }
    },

    "metrics": [
        "custom_mae"
    ],

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5,
        "dtype": "int16"
    }
}

{
    "expname": "exp999",
    "machine": "blackforest",
    "seed": 76,
    "device": "gpu",

    "data": {
        "tags_loadname": "exp001_seed55",

        "training_years": [2015, 2019],
        "training_region": [0, 20, 0, 20],

        "inference_years": [2020],
        "inference_region": {"tilelats": [[10]],
                             "tilelons": [[0]]
                            },

        "channels": [2, 4, 6],
        "scene_width": 11

    },

    "architecture": {
        "type": "resnet",
        "resnet_pretrained": true,
        "resnet_trainable": true,
        "resnet_drop_layer": -2,

        "skip_channels": null,

        "dense_in": [8192, 128],
        "dense_units": [128, 128],
        "dense_activations": ["ReLU","ReLU"],

        "dropout": 0.00,

        "final_in": 128,
        "final_activation": "Sigmoid",

        "input_noise": 5
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 0,
        "pin_memory": false,

        "batch_size": 32,
        "n_repeat_tile": 2,
        "max_batches": 100000,
        "max_epochs": 1000,

        "val_batch_size": 32,
        "val_n_repeat_tile": 1,
        "val_max_batches": 100000,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": null,
                "zero_threshold": null,
                "one_weighting": null,
                "one_threshold": null,
                "kluge_value_for_zero": 0.05
            }
        },

        "early_stopping":{
            "args":{
                "patience": 5,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "SGD",
        "args":{
            "lr": 0.00001,
            "momentum": 0.9
        }
    },

    "lr_scheduler": {
        "type": "MultiStepLR",
        "args": {
            "milestones": [5000],
            "gamma": 0.1,
            "last_epoch": -1
        }
    },

    "metrics": [
        "custom_mae"
    ],

    "inference": {
        "num_workers": 0,
        "pin_memory": false,
        "batch_size": 2048,
        "quicklook": false,
        "quicklook_skiplen": 5
    }
}

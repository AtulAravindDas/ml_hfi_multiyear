{
    "expname": "exp006",
    "machine": "blackforest",
    "seed": 22,
    "mode": null,
    "device": "gpu",

    "data": {
        "training_years": [2015, 2019],
        "inference_years": [2020, 2023],
        "training_region": [0, 20, 0, 20],
        "inference_region": [0, 20, 0, 20],

        "channels": [1, 2, 3, 4, 5, 6],
        "scene_width": 11,

        "percentage_sampling": 0.05,
        "val_frac": 0.05,

        "oversample_rare_bins": true,
        "oversample_rate": 10.0,
        "kluge_value_for_zero": null
    },

    "architecture": {
        "input_noise": 5,

        "filters": [128, 128, 128, 128, 128],
        "cnn_activation": ["ReLU","ReLU","ReLU","ReLU","ReLU"],
        "kernel_size": [3, 3, 3, 3, 3],

        "dense_in": [14148],
        "dense_units": [64],
        "dense_activations": ["ReLU"],

        "dropout": 0.10,

        "final_in": 64,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false
    },

    "trainer": {

        "resume_training": false,
        "num_workers": 2,
        "pin_memory": true,

        "batch_size": 32,
        "batches_per_epoch": 1000,
        "max_epochs": 100000,
        "max_val_batches": 1000,

        "loss":{
            "type": "SMSELoss",
            "args": {
                "zero_weighting": 100.0,
                "one_weighting": null,
                "one_threshold": null
            }
        },

        "early_stopping":{
            "args":{
                "patience": 10,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.00006,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

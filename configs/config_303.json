{
    "expname": "exp303",
    "machine": "falco",
    "seed": 11,
    "mode": null,
    "device": "gpu",

    "data": {
        "tags_loadname": "exp003_seed33",

        "training_years": [2015, 2019],
        "training_region": [-60, 60, -180, 180],

        "inference_years": [2020],
        "inference_region": [5, 6, 5, 7],

        "channels": [1, 3, 6],
        "scene_width": 11
    },

    "architecture": {
        "type": "resnet",
        "resnet_pretrained": true,
        "resnet_trainable": true,
        "resnet_drop_layer": -4,

        "input_noise": 5,

        "dense_in": [49288],
        "dense_units": [128],
        "dense_activations": ["ReLU"],

        "dropout": 0.0,

        "final_in": 128,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 0,
        "pin_memory": false,

        "batch_size": 128,
        "batches_per_epoch": 500,
        "max_epochs": 30,

        "val_batch_size": 128,
        "max_val_batches": 50,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": 10.0,
                "zero_threshold": 10,
                "one_weighting": 10.0,
                "one_threshold": 80,
                "kluge_value_for_zero": 0.2
            }
        },

        "early_stopping":{
            "args":{
                "patience": 10000,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

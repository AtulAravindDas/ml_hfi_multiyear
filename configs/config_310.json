{
    "expname": "exp310",
    "machine": "blackforest",
    "seed": 21,
    "device": "gpu",

    "data": {
        "tags_loadname": "exp006_seed76",

        "training_years": [2015, 2019],
        "training_region": [-60, 60, -180, 180],

        "inference_years": [2020],
        "inference_region": {"tilelats": [[40], [30], [50], [0], [10], [-30]],
                             "tilelons": [[-100], [110], [0], [-80], [0], [140]]
                            },

        "channels": [1, 2, 3, 4, 5, 6],
        "scene_width": 11

    },

    "architecture": {
        "type": "cnn",
        "input_noise": 5,

        "filters": [128, 128, 128, 128, 128],
        "cnn_activation": ["ReLU","ReLU","ReLU","ReLU","ReLU"],
        "kernel_size": [3, 3, 3, 3, 3],

        "dense_in": [26248],
        "dense_units": [128],
        "dense_activations": ["ReLU"],

        "dropout": 0.0,

        "final_in": 128,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 0,
        "pin_memory": false,

        "batch_size": 32,
        "n_repeat_tile": 2,
        "max_batches": 100000,
        "max_epochs": 1000,

        "val_batch_size": 32,
        "val_n_repeat_tile": 1,
        "val_max_batches": 100000,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": 5,
                "zero_threshold": 3,
                "one_weighting": null,
                "one_threshold": null,
                "kluge_value_for_zero": 0.2
            }
        },

        "early_stopping":{
            "args":{
                "patience": 5,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.00005,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "lr_scheduler": {
        "type": "MultiStepLR",
        "args": {
            "milestones": [4, 8, 12],
            "gamma": 0.1,
            "last_epoch": -1
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

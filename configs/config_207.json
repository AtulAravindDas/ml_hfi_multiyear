{
    "expname": "exp207",
    "machine": "blackforest",
    "seed": 21,
    "mode": null,
    "device": "gpu",

    "data": {
        "tags_loadname": "exp005_seed21",

        "training_years": [2015, 2019],
        "training_region": {"tilelats": [[10], [20], [-30]],
                            "tilelons": [[0, 10], [0, 10], [140]]
                           },

        "inference_years": [2020],
        "inference_region": {"tilelats": [[40], [30], [50], [0], [10], [-30]],
                             "tilelons": [[-100], [110], [0], [-80], [0], [140]]
                            },

        "resample_validation": true,
        "n_keep_per_tile": 100,

        "channels": [1, 3, 6],
        "scene_width": 11
    },

    "architecture": {
        "type": "resnet",
        "resnet_pretrained": true,
        "resnet_trainable": true,
        "resnet_drop_layer": -4,

        "input_noise": 5,

        "dense_in": [49288],
        "dense_units": [128],
        "dense_activations": ["ReLU"],

        "dropout": 0.0,

        "final_in": 128,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 2,
        "pin_memory": true,

        "batch_size": 32,
        "batches_per_epoch": 2000,
        "max_epochs": 10,
        "val_batch_size": 32,
        "max_val_batches": 100,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": 5,
                "zero_threshold": 3,
                "one_weighting": 5,
                "one_threshold": 0.9,
                "kluge_value_for_zero": 0.25
            }
        },

        "early_stopping":{
            "args":{
                "patience": 10000,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.00005,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "metrics": [
        "custom_mae"
    ]
}

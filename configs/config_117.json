{
    "expname": "exp117",
    "machine": "blackforest",
    "seed": 55,
    "mode": null,
    "device": "gpu",

    "data": {
        "globaltags_loadname": "exp115_seed55",

        "training_years": [2015, 2019],
        "inference_years": [2020],
        "training_region": [0, 20, 0, 20],
        "inference_region": [18, 20, 7, 9],

        "channels": [1, 2, 3, 4, 5, 6],
        "scene_width": 11,

        "percentage_sampling": 0.05,
        "val_frac": 0.05,

        "oversample_rare_bins": true,
        "oversample_rate": 10.0
    },

    "architecture": {
        "type": "cnn",
        "input_noise": 5,

        "filters": [128, 128, 128, 128, 128],
        "cnn_activation": ["ReLU","ReLU","ReLU","ReLU","ReLU"],
        "kernel_size": [3, 3, 3, 3, 3],

        "dense_in": [14148],
        "dense_units": [128],
        "dense_activations": ["ReLU"],

        "dropout": 0.0,

        "final_in": 128,
        "final_activation": "Sigmoid"
    },

    "inference": {
        "num_workers": 2,
        "pin_memory": true,
        "batch_size": 1024,
        "quicklook": false,
        "quicklook_skiplen": 5
    },

    "trainer": {

        "resume_training": true,
        "num_workers": 2,
        "pin_memory": true,

        "batch_size": 32,
        "batches_per_epoch": 2000,
        "max_epochs": 10000,
        "max_val_batches": 250,

        "loss":{
            "type": "WeightedSMSELoss",
            "args": {
                "zero_weighting": 1000,
                "one_weighting": null,
                "one_threshold": null,
                "kluge_value_for_zero": null
            }
        },

        "early_stopping":{
            "args":{
                "patience": 10,
                "min_delta": 0.00
            }
        }
    },

    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.00005,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "metrics": [
        "custom_mae"
    ]
}
